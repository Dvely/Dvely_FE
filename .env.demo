# 시연 전용 설정. `bun run dev:demo` 가 --mode demo 로 이 파일을 읽는다.
#
# Vite 우선순위상 .env.demo 가 .env.local 보다 뒤에 적용되므로, 로컬에 어떤 값이
# 들어 있든 시연 실행에서는 이 파일이 이긴다.

# 시연 모드 스위치. 이 값이 'true' 일 때만 데모 어댑터가 끼워진다
VITE_DEMO_MODE=true

# 시연 모드에서는 요청이 네트워크로 나가지 않으므로 실제로 쓰이지 않는다.
# axios baseURL 이 undefined 가 되지 않게만 채워 둔다
VITE_API_URL=/api/v1

# 대기 시간 배속. 1 = 기본(전체 흐름 1분 남짓), 2 = 절반
VITE_DEMO_SPEED=1
