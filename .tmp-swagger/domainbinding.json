{
  "openapi": "3.1.0",
  "info": {
    "title": "Qeploy API",
    "description": "Qeploy backend API — natural-language driven web app generation, GitHub Pages/BYOC deployment, domain binding, and cloud infrastructure operation.\n\n### Common response envelope\nEvery response (except SSE, redirects, GitHub webhook callback, and the preview proxy) is wrapped as:\n```json\n{ \"status\": 200, \"code\": \"SUCCESS\", \"message\": \"...\", \"data\": { } }\n```\n`data` is omitted (not `null`) on responses with no body (e.g. 204). Frontend clients should unwrap `data` after checking `response.ok`; see `docs/FRONTEND_API_GUIDE.md` for the reference `http.ts` implementation.\n\n### Error codes\nErrors use the same envelope with `data` omitted. `code` is one of: `BAD_REQUEST`(400) · `UNAUTHORIZED`(401) · `INVALID_TOKEN`(401) · `EXPIRED_REFRESH_TOKEN`(401) · `REVOKED_REFRESH_TOKEN`(401) · `FORBIDDEN`(403) · `GITHUB_APP_NOT_INSTALLED`(403) · `NOT_FOUND`(404) · `METHOD_NOT_ALLOWED`(405) · `CONFLICT`(409) · `INTERNAL_SERVER_ERROR`(500). `message` carries the specific, human-readable detail — treat `code` as the stable machine-readable discriminator.\n\n### Authentication\nBearer JWT (see the **JWT TOKEN** security scheme below). Obtain a token via the GitHub OAuth flow (`Auth` group), then send `Authorization: Bearer {accessToken}` on every authenticated request. Access tokens expire in 1 hour; use `POST /api/v1/auth/refresh` (rotation — both tokens are replaced) before that. A small set of endpoints are unauthenticated by design: GitHub OAuth/App URL and callback endpoints, `POST /api/v1/auth/refresh`, and `POST /api/v1/webhook/github` (GitHub-signed, not JWT).\n",
    "version": "0.0.1"
  },
  "servers": [{ "url": "/" }],
  "security": [{ "JWT TOKEN": [] }],
  "tags": [{ "name": "DomainBinding", "description": "도메인 검색, 연결, DNS 검증 API" }],
  "paths": {
    "/api/v1/projects/{projectId}/domains": {
      "get": {
        "tags": ["DomainBinding"],
        "summary": "프로젝트 도메인 목록 조회",
        "description": "프로젝트에 연결된 도메인 목록을 조회합니다.",
        "operationId": "getProjectDomains",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DomainResponse" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["DomainBinding"],
        "summary": "도메인 연결 요청",
        "description": "관리형 또는 커스텀 도메인 연결을 Agent task로 제출합니다. 프로젝트 Domain Approval 정책이 켜져 있으면 승인 후 실행됩니다.",
        "operationId": "bindDomain",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BindDomainRequest" } }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/DomainBindingSubmissionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/domains/{domainId}/verification-checks": {
      "post": {
        "tags": ["DomainBinding"],
        "summary": "DNS 검증 재시도",
        "description": "현재 DNS 설정을 조회해 도메인 연결 상태를 갱신합니다.",
        "operationId": "checkVerification",
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/DomainResponse" } } }
          }
        }
      }
    },
    "/api/v1/domains/{domainId}": {
      "get": {
        "tags": ["DomainBinding"],
        "summary": "도메인 상태 조회",
        "description": "도메인 연결 및 DNS 검증 상태를 조회합니다.",
        "operationId": "getDomain",
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/DomainResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["DomainBinding"],
        "summary": "도메인 연결 해제 요청",
        "description": "도메인 연결 해제를 Agent task로 제출합니다. 프로젝트 Domain Approval 정책이 켜져 있으면 승인 후 제거합니다.",
        "operationId": "deleteDomain",
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/DomainBindingSubmissionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/domains/{domainId}/verification-guide": {
      "get": {
        "tags": ["DomainBinding"],
        "summary": "DNS 검증 가이드 조회",
        "description": "사용자가 DNS에 등록해야 하는 A/CNAME 레코드 값을 반환합니다.",
        "operationId": "getVerificationGuide",
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/VerificationGuideResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/domain-search": {
      "get": {
        "tags": ["DomainBinding"],
        "summary": "도메인 검색",
        "description": "키워드 기준으로 현재 지원하는 관리형 서브도메인의 사용 가능 여부를 조회합니다.",
        "operationId": "search",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "검색할 서브도메인 라벨",
            "required": true,
            "schema": { "type": "string" },
            "example": "myproject"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/DomainSearchResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BindDomainRequest": {
        "type": "object",
        "description": "도메인 연결 요청. type에 따라 label(managed_subdomain) 또는 hostname(custom_domain)만 채웁니다. 실제 연결은 Agent task로 비동기 처리되므로 응답은 domainId가 아니라 taskId입니다.",
        "properties": {
          "type": {
            "type": "string",
            "description": "도메인 타입. managed_subdomain: Qeploy 관리형 서브도메인, custom_domain: 사용자 보유 도메인, purchasable_domain: 검색 후보만 제공(구매/연결 미지원)",
            "enum": ["managed_subdomain", "custom_domain", "purchasable_domain"],
            "example": "managed_subdomain"
          },
          "label": {
            "type": "string",
            "description": "type=managed_subdomain일 때 사용할 서브도메인 라벨. 최종 hostname은 {label}.qeploy.com",
            "example": "myproject"
          },
          "hostname": {
            "type": "string",
            "description": "type=custom_domain일 때 연결할 전체 hostname",
            "example": "www.example.com"
          },
          "verificationMethod": {
            "type": "string",
            "description": "DNS 검증 방식. type=custom_domain에서 사용, 생략 시 CNAME",
            "enum": ["CNAME", "A"],
            "example": "CNAME"
          },
          "hostingTarget": {
            "type": "string",
            "description": "배포 대상. 생략 시 GITHUB_PAGES",
            "enum": ["GITHUB_PAGES", "AWS", "GCP"],
            "example": "GITHUB_PAGES"
          }
        },
        "required": ["type"]
      },
      "DomainBindingSubmissionResponse": {
        "type": "object",
        "description": "도메인 연결/해제 요청 접수 응답. 실제 처리는 Agent task로 비동기 실행되므로 GET /api/v1/agent/tasks/{taskId}로 완료 여부를 폴링한 뒤 GET 도메인 API로 확정된 결과를 조회하세요.",
        "properties": {
          "taskId": { "type": "string", "description": "비동기 Agent task ID" },
          "status": {
            "type": "string",
            "description": "task 현재 상태",
            "example": "WAITING_APPROVAL"
          },
          "approvalIds": {
            "type": "array",
            "description": "Domain Approval 정책이 켜져 있을 때 생성된 승인 ID 목록. 정책이 꺼져 있으면 빈 배열",
            "items": { "type": "integer", "format": "int64" }
          }
        }
      },
      "DomainResponse": {
        "type": "object",
        "description": "도메인 연결 및 DNS 검증 상태",
        "properties": {
          "domainId": { "type": "integer", "format": "int64", "description": "도메인 ID" },
          "projectId": { "type": "integer", "format": "int64", "description": "프로젝트 ID" },
          "type": {
            "type": "string",
            "description": "도메인 타입",
            "enum": ["managed_subdomain", "custom_domain", "purchasable_domain"],
            "example": "managed_subdomain"
          },
          "hostingTarget": {
            "type": "string",
            "description": "배포 대상",
            "enum": ["GITHUB_PAGES", "AWS", "GCP"],
            "example": "GITHUB_PAGES"
          },
          "hostname": {
            "type": "string",
            "description": "전체 hostname",
            "example": "myproject.qeploy.com"
          },
          "status": {
            "type": "string",
            "description": "연결 상태",
            "enum": ["REQUESTED", "PROVISIONING", "VERIFYING", "CONNECTED", "FAILED"],
            "example": "VERIFYING"
          },
          "verificationMethod": {
            "type": "string",
            "description": "DNS 검증 방식. managed_subdomain은 Cloudflare가 자동 처리하므로 null일 수 있음",
            "enum": ["CNAME", "A"]
          },
          "dnsTarget": {
            "type": "string",
            "description": "사용자가 DNS에 등록해야 하는 값. GitHub Pages 대상이면 실제 배포된 GitHub Pages hostname"
          },
          "httpsEnforced": { "type": "boolean", "description": "HTTPS 강제 여부" },
          "certificateStatus": {
            "type": "string",
            "description": "TLS 인증서 발급 상태",
            "enum": ["PENDING", "PROVISIONING", "ACTIVE", "FAILED"],
            "example": "ACTIVE"
          },
          "certificateExpiresAt": {
            "type": "string",
            "format": "date",
            "description": "인증서 만료일. 미발급 시 null"
          },
          "lastCheckedAt": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 DNS 검증 확인 시각"
          },
          "createdAt": { "type": "string", "format": "date-time", "description": "생성 시각" },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 수정 시각"
          }
        }
      },
      "Record": {
        "type": "object",
        "description": "등록해야 하는 DNS 레코드 1건",
        "properties": {
          "type": { "type": "string", "description": "레코드 타입", "example": "CNAME" },
          "host": {
            "type": "string",
            "description": "레코드 host(서브도메인 부분)",
            "example": "www"
          },
          "value": { "type": "string", "description": "레코드 값" }
        }
      },
      "VerificationGuideResponse": {
        "type": "object",
        "description": "custom_domain 연결 시 사용자가 외부 DNS provider에 등록해야 하는 레코드 안내",
        "properties": {
          "hostname": {
            "type": "string",
            "description": "검증 대상 hostname",
            "example": "www.example.com"
          },
          "verificationMethod": {
            "type": "string",
            "description": "검증 방식",
            "enum": ["CNAME", "A"]
          },
          "records": { "type": "array", "items": { "$ref": "#/components/schemas/Record" } }
        }
      },
      "DomainSearchResponse": {
        "type": "object",
        "description": "도메인 검색 결과. 현재는 managed_subdomain의 실제 사용 가능 여부만 Cloudflare로 조회하고, purchasable_domain은 후보만 제공합니다(실제 구매/등록 미지원).",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "검색에 사용한 키워드",
            "example": "myproject"
          },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Result" } }
        }
      },
      "Result": {
        "type": "object",
        "description": "검색 후보 1건",
        "properties": {
          "type": {
            "type": "string",
            "description": "후보 타입",
            "enum": ["managed_subdomain", "purchasable_domain"]
          },
          "hostname": {
            "type": "string",
            "description": "전체 hostname",
            "example": "myproject.qeploy.com"
          },
          "available": { "type": "boolean", "description": "사용 가능 여부" },
          "price": {
            "type": "number",
            "description": "가격. managed_subdomain은 무료(0)이거나 null일 수 있음"
          },
          "currency": { "type": "string", "description": "통화. 가격이 없으면 null" }
        }
      }
    },
    "securitySchemes": {
      "JWT TOKEN": {
        "type": "http",
        "name": "JWT TOKEN",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
